{
  "name": "vielinea-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + TypeScript REST API for the Vielinea storefront, backed by Supabase PostgreSQL.",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:check": "tsx scripts/check.ts",
    "db:inspect": "tsx scripts/inspect.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/verify.ts",
    "db:verify-images": "tsx scripts/verify-images.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:admin": "tsx scripts/e2e-admin.ts",
    "test:admin-products": "tsx scripts/e2e-admin-products-optional.ts",
    "test:chat": "tsx scripts/e2e-chat.ts",
    "test:guest-chat": "tsx scripts/e2e-guest-chat.ts",
    "test:cors": "tsx scripts/e2e-cors.ts",
    "test:account": "tsx scripts/e2e-account.ts",
    "test:cod": "tsx scripts/e2e-cod.ts",
    "test:card": "tsx scripts/e2e-card.ts",
    "test:accessories": "tsx scripts/e2e-accessories.ts",
    "test:hero-slides": "tsx scripts/e2e-hero-slides.ts",
    "test:selected-images": "tsx scripts/e2e-selected-images.ts",
    "test:timeline": "tsx scripts/e2e-company-timeline.ts",
    "test:faqs": "tsx scripts/e2e-faqs.ts",
    "test:order-email": "tsx scripts/verify-order-email.ts",
    "email:diagnose": "tsx scripts/email-diagnose.ts",
    "test:all": "npm run test:e2e && npm run test:admin && npm run test:admin-products && npm run test:chat && npm run test:guest-chat && npm run test:cors && npm run test:account && npm run test:cod && npm run test:card && npm run test:accessories && npm run test:hero-slides && npm run test:selected-images && npm run test:timeline && npm run test:faqs && npm run test:order-email",
    "db:final-check": "tsx scripts/final-check.ts",
    "db:cleanup-tests": "tsx scripts/cleanup-test-rows.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:verify"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
