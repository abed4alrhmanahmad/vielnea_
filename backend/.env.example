# ---------------------------------------------------------------------------
# Vielinea backend environment — EXAMPLE / PLACEHOLDERS ONLY
# Copy to `.env` and fill in the real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# The browser origins allowed by CORS, comma-separated. Requests carry
# credentials, so this is an explicit allowlist — never "*".
#
#   8080  Vite dev server (frontend/vite.config.ts + @lovable.dev/vite-tanstack-config)
#   8788  wrangler dev — the local preview of the production build
#
# `localhost` and `127.0.0.1` are different origins to a browser, so list both
# spellings of any host you actually open.
#
# In a deployed environment set this to the real site origin only
# (e.g. https://vielinea.com) and drop the local entries.
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8788,http://localhost:8788

# Supabase project (public, safe values)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — SECRET. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL connection — DB_PASSWORD is SECRET.
#
# Discrete fields are preferred over a URL: the password is passed verbatim, so
# characters like $ % @ : / # need no percent-encoding and cannot be silently
# mis-decoded by a connection-string parser.
#
# IMPORTANT: use the IPv4 *pooler* host, not db.<ref>.supabase.co, which is
# IPv6-only and unreachable from networks without an IPv6 route.
#   Session pooler   (port 5432) -> migrations / DDL
#   Transaction pool (port 6543) -> runtime queries
# User is `postgres.<project-ref>`, not plain `postgres`.
#
# The correct region/instance can be found by probing: the right host replies
# "password authentication failed", the wrong one "Tenant or user not found".
DB_HOST=aws-0-YOUR_REGION.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password
DB_NAME=postgres

# Alternative to the DB_* fields above (used only if they are not set):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Optional — SECRET. Points the runtime pool at the transaction pooler
# (port 6543) while migrations keep using the session pooler above. Leave
# unset and the runtime pool reuses the DB_* / DATABASE_URL connection.
# DATABASE_POOL_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Auth — SECRET. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Seeded demo customer account
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-me-demo-password

# Seeded admin account (change the password before any real deployment)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password

# --- Payments ---------------------------------------------------------------
# Which card-payment adapter to use.
#
#   unconfigured  (default) Card payment is refused with a 503. This is the
#                 truthful setting while VIELINEA has no processor account —
#                 no card is charged and no order is ever marked paid.
#   sandbox       Local stand-in for development and the test suite. It moves
#                 NO money; it approves and declines from the standard test
#                 card numbers so the checkout path can be exercised. It is
#                 refused outright when NODE_ENV=production.
#
# To go live: add a real adapter under src/services/payment/, register it in
# src/services/payment/index.ts, set PAYMENT_PROVIDER to its name and add that
# provider's credentials below (e.g. its secret key server-side, and its
# publishable key as a VITE_ variable in frontend/.env.local).
PAYMENT_PROVIDER=unconfigured

# --- Transactional email ----------------------------------------------------
# Server-side only. None of these is ever sent to the browser.
#
# Used to notify the admin when a customer places a new order. Leave
# EMAIL_API_KEY unset and notifications are simply skipped with a log line —
# checkout keeps working exactly as before.
#
# Resend: create a key at https://resend.com/api-keys (starts with "re_").
EMAIL_API_KEY=

# Verified sender. Resend's shared onboarding domain works with no DNS setup;
# switch to your own verified domain for production.
EMAIL_FROM=Vielinea <no-reply@example.com>

# Where new-order alerts are delivered.
#
# Kept separate from ADMIN_EMAIL deliberately. ADMIN_EMAIL is the admin
# login and seeded account — changing it moves the admin user and the E2E
# credentials. This variable is only a destination mailbox, so alerts can
# be re-pointed without touching authentication.
#
# Falls back to ADMIN_EMAIL when left blank.
ORDER_NOTIFICATION_EMAIL=orders@example.com
