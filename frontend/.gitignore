# Secrets — never commit.
# `*.local` further down already catches .env.local; these rules cover every
# other .env variant (a plain `.env` was previously NOT ignored here).
.env
.env.*
!.env.example

# Stray credential material
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*service-account*.json
*serviceaccount*.json
secrets.json
credentials.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
