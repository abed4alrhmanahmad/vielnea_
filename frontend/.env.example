# ---------------------------------------------------------------------------
# Vielinea frontend environment — EXAMPLE / PLACEHOLDERS ONLY
#
# Copy to `.env.local` and adjust if your backend runs elsewhere.
#
# Everything here is inlined into the browser bundle at build time, so it must
# contain PUBLIC values only. No Supabase URL, no anon key, no service-role
# key, no database password, no JWT secret — those live only in backend/.env
# and are never read by this app.
# ---------------------------------------------------------------------------

# Base URL of the Vielinea REST API, including the /api prefix.
# The backend dev server listens on port 5000.
# Falls back to a built-in default when unset.
VITE_API_URL=http://localhost:5000/api
